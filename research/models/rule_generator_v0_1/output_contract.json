{
  "type": "object",
  "properties": {
    "v": {
      "const": "1"
    },
    "feature": {
      "type": "string"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "role": {
      "enum": [
        "HR",
        "SR"
      ]
    },
    "state": {
      "enum": [
        "proposed",
        "deferred",
        "request_evidence",
        "no_applicable"
      ]
    },
    "basis": {
      "enum": [
        "ddl_not_null",
        "observed_diagnostic",
        "reference_p95",
        "insufficient",
        "none"
      ]
    },
    "condition": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "is_missing"
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "gt",
                "lt"
              ]
            },
            "value": {
              "type": [
                "boolean",
                "number"
              ]
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "gt"
            },
            "baseline": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "baseline"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "needed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "v",
    "feature",
    "sha",
    "role",
    "state",
    "basis",
    "condition",
    "evidence",
    "needed",
    "reason"
  ],
  "additionalProperties": false
}
