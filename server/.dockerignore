# Only application code and contracts belong in the server build context.
**
!frontend/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/tsconfig*.json
!frontend/vite.config.ts
!frontend/nginx.conf
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!backend/
!backend/package.json
!backend/package-lock.json
!backend/tsconfig.json
!backend/src/
!backend/src/**
!worker/
!worker/Dockerfile
!worker/requirements.txt
!worker/pg_queue.py
!worker/common/
!worker/common/*.py
!worker/collector/
!worker/collector/*.py
!worker/detector/
!worker/detector/*.py
!worker/trainer/
!worker/trainer/*.py
!contracts/
!contracts/**/*.json
!contracts/**/*.md

# Keep local credentials and data excluded even below an allowed directory.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.csv
**/*.sqlite*
**/*.db
**/*.log
**/*.pt
**/*.pth
**/*.safetensors
**/*.onnx
**/*.bin
**/node_modules
**/dist
backend/data/
**/coverage
