{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prepared-csv-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "sourceId", "sourceSchemaVersion", "domain", "rowCount", "inputStage", "features", "preprocessing", "split", "columns"],
  "properties": {
    "contractVersion": {"const": "prepared-csv-v1"},
    "sourceId": {"type": "string", "format": "uuid"},
    "sourceSchemaVersion": {"$ref": "#/$defs/text"},
    "domain": {"$ref": "#/$defs/text"},
    "rowCount": {"type": "integer", "minimum": 1, "maximum": 10000},
    "inputStage": {"const": "model_input"},
    "features": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "unit"],
      "properties": {"name": {"$ref": "#/$defs/column"}, "type": {"const": "number"}, "unit": {"$ref": "#/$defs/text"}}
    }},
    "preprocessing": {
      "type": "object", "additionalProperties": false,
      "required": ["definitionHash", "scaling", "fitHash", "fitSplit", "trainRowIdsHash"],
      "properties": {"definitionHash": {"$ref": "#/$defs/hash"}, "scaling": {"enum": ["none", "applied"]},
        "fitHash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "fitSplit": {"enum": ["train", "unknown"]},
        "trainRowIdsHash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}
    },
    "split": {"type": "object", "additionalProperties": false, "required": ["version", "timeBasis"],
      "properties": {"version": {"const": "provided-v1"}, "timeBasis": {"enum": ["occurred_at", "unspecified"]}}},
    "columns": {"type": "object", "additionalProperties": false, "required": ["rowId"],
      "properties": {"rowId": {"$ref": "#/$defs/column"}, "split": {"$ref": "#/$defs/nullableColumn"},
        "label": {"$ref": "#/$defs/nullableColumn"}, "status": {"$ref": "#/$defs/nullableColumn"}, "isSynthetic": {"$ref": "#/$defs/nullableColumn"},
        "scenario": {"$ref": "#/$defs/nullableColumn"}, "originRowId": {"$ref": "#/$defs/nullableColumn"},
        "groupId": {"$ref": "#/$defs/nullableColumn"}, "occurredAt": {"$ref": "#/$defs/nullableColumn"}}},
    "labelSource": {"type": "object", "additionalProperties": false, "required": ["kind", "reference"],
      "properties": {"kind": {"enum": ["manual", "synthetic", "unknown"]},
        "reference": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}}},
    "synthetic": {"type": "object", "additionalProperties": false, "required": ["generator", "version", "seed", "intensity", "baselineReference"],
      "properties": {"generator": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "intensity": {"type": "number", "minimum": 0, "maximum": 1000000}, "baselineReference": {"$ref": "#/$defs/text"}}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!.*[\\u0000-\\u001f])\\S(?:.*\\S)?$"},
    "column": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
    "nullableColumn": {"anyOf": [{"$ref": "#/$defs/column"}, {"type": "null"}]},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
