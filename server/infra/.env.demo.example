# Copy to .env.demo; do not commit actual passwords or JWT keys.
# Same Docker network as the existing anomaly-postgres container. URL-encode password.
PWC_DB_NETWORK=anomaly-net
DATABASE_URL=postgresql://anomaly_app:REPLACE_PASSWORD@anomaly-postgres:5432/anomaly_detection
# Optional read-only origin DB; blank uses DATABASE_URL.
DEMO_SOURCE_DATABASE_URL=
DEMO_CSV_DIR=/data/gst-dongguk/powercode-esb/tmp
DEMO_TRANSACTION_FILE=EC_TRANSACTION_MONITORING.csv
DEMO_PROCESS_FILE=EC_PROCESS_MONITORING.csv
DEMO_BODY_FILE=EC_MESSAGE_BODY.csv
ARTIFACT_ROOT_PATH=/home/gst-dongguk/powercode-demo/artifacts
AUTH_DATA_DIR=/home/gst-dongguk/powercode-demo/auth
# Rootless Docker: typically 0:0 maps to the login user. Confirm docker info first.
# Rootful Docker: set both to your host id -u/id -g; artifact/auth dirs must be writable.
PWC_CONTAINER_UID=1000
PWC_CONTAINER_GID=1000
# Required only for --profile ui. Use a separate 32+ character random secret.
JWT_SECRET=
# Reuse existing users.json or set these once when creating an empty demo auth store.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
WEB_BIND=0.0.0.0
WEB_PORT=8081
DEMO_PREPARE_CPUS=4
DEMO_PREPARE_MEMORY=8g
DETECTOR_CPUS=2
DETECTOR_MEMORY=4g
