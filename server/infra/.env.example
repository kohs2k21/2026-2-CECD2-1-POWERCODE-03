# 기존 PostgreSQL 컨테이너가 연결된 Docker 네트워크와 내부 주소.
PWC_DB_NETWORK=anomaly-net
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=24h
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
DESIGN_MODEL_TOKEN=

# 모두 서버의 절대경로. Qwen snapshot 안의 symlink 대상도 mount 안에 있어야 한다.
BUNDLE_PARENT_PATH=
RESEARCH_BUNDLE_PATH=
QWEN_BASE_PATH=
# bundle 도구가 서버 계정 소유권으로 파일을 생성하도록 id -u / id -g를 입력.
PWC_UID=1000
PWC_GID=1000
GENERATION_GPU_ID=0
WEB_BIND=0.0.0.0
WEB_PORT=8080
DRIFT_WINDOW_HOURS=24
DRIFT_MISSING_DELTA=0.10

# Plan: existing host files, no file-storage container or fresh Docker volume.
ARTIFACT_ROOT_PATH=
AUTH_DATA_DIR=
# Rootful Docker: host owner UID/GID. Rootless Docker: normally container 0:0 maps daemon owner.
# Match existing deployment ownership; do not recursively chown existing storage.
PWC_CONTAINER_UID=10001
PWC_CONTAINER_GID=10001
DETECTOR_DELIVERY_TOKEN=
COLLECTOR_SOURCE_KEY=customer-esb
COLLECTOR_CONFIGURATION_URL=http://183.111.104.98:1112
COLLECTOR_MONITORING_URL=http://183.111.104.98:1114
# The attachment uses HTTP; opt in for this exact hostname only.
COLLECTOR_HTTP_HOST=183.111.104.98
COLLECTOR_ACCESS_TOKEN=
COLLECTOR_POLL_SECONDS=2

# Separate least privilege runtime logins (database-roles.sql); fallback DATABASE_URL for local QA only.
API_DATABASE_URL=
COLLECTOR_DATABASE_URL=
DETECTOR_DATABASE_URL=
TRAINER_DATABASE_URL=
LLM_DATABASE_URL=

# Shared full-pipeline input. Starts paused; select API/CSV in /detection/pipeline.
CSV_INPUT_DIR=/data/gst-dongguk/powercode-esb/tmp
INPUT_TRANSACTION_FILE=EC_TRANSACTION_MONITORING.csv
INPUT_PROCESS_FILE=EC_PROCESS_MONITORING.csv
INPUT_MESSAGE_FILE=EC_MESSAGE_MONITORING.csv
INPUT_BODY_FILE=EC_MESSAGE_BODY.csv
INPUT_CONTRACT_DIR=./input-contracts
# Blank accepts explicitly tagged normalized {layer,values} log records.
# Set only after matching a real non-empty log response; the example is not a verified customer contract.
COLLECTOR_LOG_MAPPING_FILE=
# Example: /input-contracts/customer-logs.json
