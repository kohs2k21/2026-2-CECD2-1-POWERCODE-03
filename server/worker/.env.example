# 서버에서 server/worker/.env로 복사한 뒤 데이터베이스 연결 주소를 입력한다.
DATABASE_URL=
# Trainer 산출물과 Detector가 함께 읽는 영속 저장소의 절대 경로.
ARTIFACT_ROOT=
# 모니터 측정 기간(시간)과 결측률 증가 경계.
DRIFT_WINDOW_HOURS=24
DRIFT_MISSING_DELTA=0.10

# 독립 실행 연구 번들. research_bundle.py로 만든 디렉터리.
RESEARCH_BUNDLE_ROOT=/srv/powercode/research-runtime
# 실제 feature_v5 모델 호출을 기본으로 사용. numeric은 이전 기준선 시험용.
FEATURE_DESIGN_PROVIDER=research
DESIGN_MODEL_URL=http://127.0.0.1:8010
# GPU 생성 서비스와 Trainer에서 동일한 32자 이상 임의 비밀값 사용.
DESIGN_MODEL_TOKEN=
# GPU 프로세스에서만 설정. 저장소에는 Base 가중치가 없다.
RULE_MODEL_BASE_PATH=/srv/models/Qwen3.6-27B/6a9e13bd6fc8f0983b9b99948120bc37f49c13e9
